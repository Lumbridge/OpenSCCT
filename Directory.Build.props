<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- The OpenSCCT version (OpenScct.Net BuildInfo: the menus, the server browser and the master; the build number is in Directory.Build.targets); releases pass -p:Version. -->
    <VersionPrefix>0.8.94</VersionPrefix>
    <!-- The launcher's own version (src/OpenScct.Launcher), apart from the game's: bump it only when the launcher changes.
         Players' launchers update themselves only to a newer launcher; a game release carries the same launcher again
         (tools/release/New-Release.ps1 reuses the published exe and refuses changed launcher code under an old version). -->
    <LauncherVersion>0.8.47</LauncherVersion>
  </PropertyGroup>
  <!-- Shipped builds name their sources, PDBs and Source Link documents from /_/ instead of the folder they were built
       in (deterministic source paths, mapped from the git root), so released DLLs and PDBs carry no local paths. Test
       projects keep real paths (they find repository files from their own). -->
  <PropertyGroup Condition="('$(Configuration)' == 'Release' or '$(Configuration)' == 'ExportRelease') and !$(MSBuildProjectName.EndsWith('.Tests'))">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
