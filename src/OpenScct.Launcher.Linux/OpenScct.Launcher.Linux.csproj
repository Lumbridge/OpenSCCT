<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OpenSCCT.Launcher-linux-x64</AssemblyName>
    <RootNamespace>OpenScct.Launcher.Linux</RootNamespace>
    <Version>$(LauncherVersion)</Version>
    <Product>OpenSCCT Launcher</Product>
    <Company>OpenSCCT</Company>
    <Description>Native OpenSCCT launcher for Linux</Description>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="../OpenScct.Launcher.Core/OpenScct.Launcher.Core.csproj" />
    <Compile Include="../../shared/ProjectLinks.cs" Link="Shared/ProjectLinks.cs" />
    <EmbeddedResource Include="../../game/branding/icon.ico" LogicalName="OpenScct.Launcher.icon.ico" />
    <EmbeddedResource Include="licenses/**/*" LogicalName="OpenScct.Launcher.Licenses.%(Filename)%(Extension)" />
    <None Update="licenses/**/*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
