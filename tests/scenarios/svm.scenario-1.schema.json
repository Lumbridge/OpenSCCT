{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "svm.scenario/1",
  "title": "SVM differential test scenario",
  "type": "object",
  "required": ["format", "id", "title", "map", "mode", "players", "spawn", "settleFrames", "durationFrames", "inputs", "repeats", "covers"],
  "properties": {
    "format": {"const": "svm.scenario/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$"},
    "title": {"type": "string", "minLength": 1},
    "map": {"type": "string", "minLength": 1},
    "mode": {"enum": ["playlevel"]},
    "players": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "object", "required": ["team"], "properties": {"team": {"enum": ["spy", "merc"]}}}
    },
    "spawn": {
      "type": "object",
      "required": ["floor", "yaw"],
      "properties": {
        "floor": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "yaw": {"type": "integer"},
        "clearance": {"type": "number"},
        "spot": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "oneOf": [
          {"properties": {"op": {"const": "teleport"}}},
          {"properties": {"op": {"const": "stance"}, "crouched": {"type": "boolean"}}, "required": ["crouched"]},
          {"properties": {"op": {"const": "fastSpeed"}, "value": {"type": "boolean"}}, "required": ["value"]},
          {"properties": {"op": {"const": "view"}, "pitch": {"type": "integer"}, "yaw": {"type": "integer"}}, "required": ["pitch", "yaw"]},
          {"properties": {"op": {"const": "write"}, "target": {"enum": ["pawn", "controller"]}, "field": {"enum": ["Health", "bFastSpeed"]}, "value": {"type": "number"}}, "required": ["target", "field", "value"]},
          {"properties": {"op": {"const": "wait"}, "frames": {"type": "integer", "minimum": 1}}, "required": ["frames"]},
          {"properties": {"op": {"const": "waitStill"}, "maxFrames": {"type": "integer", "minimum": 1}}, "required": ["maxFrames"]},
          {"properties": {"op": {"const": "leaveGE"}, "maxFrames": {"type": "integer", "minimum": 1}}, "required": ["maxFrames"]}
        ]
      }
    },
    "settleFrames": {"type": "integer", "minimum": 0},
    "durationFrames": {"type": "integer", "minimum": 1},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame"],
        "minProperties": 2,
        "additionalProperties": false,
        "properties": {
          "frame": {"type": "integer", "minimum": 0},
          "buttons": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"enum": ["BT_Up", "BT_Down", "BT_Left", "BT_Right", "bCrouch", "bRoll", "bUsing", "bFireMode", "bUseBackToWall"]},
            "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 255}
          },
          "jump": {"const": true},
          "view": {"type": "object", "required": ["pitch", "yaw"], "properties": {"pitch": {"type": "integer"}, "yaw": {"type": "integer"}}},
          "fastSpeed": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "repeats": {"type": "integer", "minimum": 1},
    "profile": {"enum": ["locomotion", "traversal"]},
    "measure": {"type": "object"},
    "covers": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^(uc|nat|eng|rep|def|fmt|rl):\\S+$"}
    }
  }
}
