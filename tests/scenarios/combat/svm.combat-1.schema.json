{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "svm.combat/1",
  "title": "SVM two-player combat scenario",
  "type": "object",
  "required": ["format", "id", "title", "map", "mode", "local", "target", "settleFrames", "durationFrames", "events", "repeats", "covers"],
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "bone": {"enum": ["head", "spine2", "spine1", "pelvis", "l_upperarm", "l_forearm", "l_hand", "l_thigh", "l_calf", "l_foot", "r_upperarm", "r_forearm", "r_hand", "r_thigh", "r_calf", "r_foot", "spine", "neck"]},
    "player": {
      "type": "object",
      "required": ["team", "floor", "yaw"],
      "properties": {
        "team": {"enum": ["spy", "merc"]},
        "floor": {"$ref": "#/$defs/vec3"},
        "yaw": {"type": "integer"},
        "crouched": {"type": "boolean"},
        "atStart": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "format": {"const": "svm.combat/1"},
    "id": {"type": "string", "pattern": "^combat\\.[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "map": {"type": "string", "minLength": 1},
    "mode": {"enum": ["playlevel"]},
    "local": {"$ref": "#/$defs/player"},
    "target": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/player"}]},
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {"op": {"enum": ["stance", "draw", "holster", "refill", "rof", "heal", "clearHistory", "wait", "waitStill", "targetRole"]}}
      }
    },
    "settleFrames": {"type": "integer", "minimum": 0},
    "durationFrames": {"type": "integer", "minimum": 1},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "do"],
        "properties": {
          "frame": {"type": "integer", "minimum": 0},
          "do": {"enum": ["aim", "aimPoint", "fire", "fireUp", "altFire", "altFireUp", "rof", "heal", "healLocal", "place", "teleport", "crouchTarget", "grenade", "targetFire", "clearHistory", "spawnTarget", "removeTarget", "refill", "targetRole", "buttons", "note"]},
          "bone": {"$ref": "#/$defs/bone"},
          "to": {"$ref": "#/$defs/bone"},
          "offset": {"$ref": "#/$defs/vec3"},
          "point": {"$ref": "#/$defs/vec3"},
          "mode": {"enum": ["single", "burst", "auto"]},
          "hp": {"type": "integer", "minimum": 1, "maximum": 1000},
          "floor": {"$ref": "#/$defs/vec3"},
          "yaw": {"type": "integer"},
          "crouched": {"type": "boolean"},
          "kind": {"enum": ["frag", "smoke"]},
          "at": {"$ref": "#/$defs/vec3"},
          "fromTarget": {"$ref": "#/$defs/vec3"},
          "fromLocal": {"$ref": "#/$defs/vec3"},
          "by": {"enum": ["local", "target"]},
          "fuse": {"type": "number", "minimum": 0},
          "team": {"enum": ["spy", "merc"]},
          "atStart": {"type": "boolean"},
          "role": {"enum": ["host", "remote"]},
          "who": {"enum": ["local", "target"]},
          "buttons": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"enum": ["BT_Up", "BT_Down", "BT_Left", "BT_Right", "bCrouch", "bRoll", "bUsing", "bFireMode", "bReload", "bROF", "bUseBackToWall"]},
            "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 255}
          },
          "note": {"type": "string"}
        }
      }
    },
    "repeats": {"type": "integer", "minimum": 1},
    "order": {"type": "integer", "minimum": 0, "maximum": 100},
    "measure": {"type": "object"},
    "covers": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^(uc|nat|eng|rep|def|fmt|rl):\\S+$"}
    },
    "spot": {"type": "string"},
    "notes": {"type": "string"}
  }
}
