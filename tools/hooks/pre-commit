#!/bin/sh
# Refuses a commit that would add game files, decompiled output or local-only data.
# Enable once per clone with tools/hooks/install.ps1 (sets core.hooksPath to tools/hooks).

root=$(git rev-parse --show-toplevel) || exit 1

for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 &&
        "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "$candidate" "$root/tools/ci/no_game_data.py" --staged --root "$root"
    fi
done

echo "pre-commit: Python 3.10 or newer is needed to run tools/ci/no_game_data.py" >&2
exit 1
