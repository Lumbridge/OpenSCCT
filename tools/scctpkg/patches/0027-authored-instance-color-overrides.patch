+@dataclass(frozen=True)
+class AuthoredColorOverride:
+    """An explicitly attributed actor color stream, already in RGBA vertex order.
+
+    The source-specific caller proves the stream's provenance. Mesh identity and
+    ordered vertex attributes guard against applying it to another asset/layout.
+    This chooses authored modulation, without the PC baked-light/ambient fold.
+    """
+    mesh_key: str
+    vertex_sha256: str
+    rgba: bytes
+
+
+def authored_color_vertex_identity(mesh: StaticMesh) -> str:
+    """Fingerprint the reader's ordered UE positions, normals and every UV stream."""
+    digest = hashlib.sha256()
+    streams = [mesh.positions, mesh.normals, *mesh.uvs]
+    digest.update(struct.pack('<I', len(streams)))
+    for stream in streams:
+        data = np.ascontiguousarray(stream, dtype='<f4')
+        if data.ndim != 2 or not np.isfinite(data).all():
+            raise ValueError('Authored color vertex identity needs finite two-dimensional attributes')
+        digest.update(struct.pack('<II', *data.shape))
+        digest.update(data.tobytes())
+    return digest.hexdigest()
+
+
+def _override_colors(actor: ActorRecord, mesh: StaticMesh, value: AuthoredColorOverride) -> np.ndarray:
+    if not isinstance(value, AuthoredColorOverride):
+        raise ValueError(f'{actor.name}: expected an AuthoredColorOverride')
+    if value.mesh_key != actor.mesh_key:
+        raise ValueError(f'{actor.name}: authored color override mesh identity differs')
+    if value.vertex_sha256 != authored_color_vertex_identity(mesh):
+        raise ValueError(f'{actor.name}: authored color override vertex identity differs')
+    if type(value.rgba) is not bytes or len(value.rgba) != len(mesh.positions) * 4 or not len(mesh.positions):
+        raise ValueError(f'{actor.name}: authored color override needs exactly four RGBA bytes per vertex')
+    return np.frombuffer(value.rgba, dtype=np.uint8).reshape(-1, 4).copy()
+
